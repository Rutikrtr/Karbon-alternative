PORT=4000
# Your MongoDB connection string (e.g. MongoDB Atlas). Leave empty for a temporary in-memory DB.
MONGODB_URI=
JWT_SECRET=change-me-to-a-long-random-string

# First Super Admin — created automatically on first start when the database has no users.
ADMIN_NAME=Your Name
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Set to true to fill an empty database with demo teams, clients and tasks instead.
SEED_DEMO=false

# Optional: path to a local mongod binary for the in-memory DB
# MONGOMS_SYSTEM_BINARY=C:/mongobin/mongod.exe
